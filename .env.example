# Copy this file to .env and fill in the key for the provider you chose in config/settings.toml.
# .env is ignored by git. This example file is safe to commit because it holds no values.

# Groq free-tier TPM is about 8k. Calls are already capped in code; this key is still required
# when [llm] (or a per-use entry) has provider = "groq".
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
